# ---------------------------------------------------------------------------
# Council - API keys
#
# Every provider below has a FREE tier that needs no payment card.
# You do NOT need all of them. Council uses whatever keys it finds and skips
# the rest. One key works. Three or four is much better, because the whole
# point of the tool is that the answers disagree with each other.
#
# Recommended order to sign up, best first:
# ---------------------------------------------------------------------------

# 1. Groq - free, no card, very fast. Start here.
#    https://console.groq.com/keys
GROQ_API_KEY=

# 2. Google AI Studio - free, no card. STRONGLY RECOMMENDED as your second key.
#    Its token ceiling is far higher than Groq's, so the seats with the biggest
#    inputs (Synthesis, Critic, Judge) live here. Without it they fall back to
#    Groq and Debate mode runs much slower.
#    https://aistudio.google.com/apikey
GEMINI_API_KEY=

# 3. Cerebras - free tier, no card, extremely fast.
#    https://cloud.cerebras.ai
CEREBRAS_API_KEY=

# 4. GitHub Models - free with any GitHub account.
#    Make a fine-grained token with NO scopes at
#    https://github.com/settings/tokens
GITHUB_TOKEN=

# 5. Mistral - free experiment tier (needs phone verification).
#    https://console.mistral.ai
MISTRAL_API_KEY=

# --- More variety. These bring model FAMILIES you do not otherwise have ---
# You have gpt-oss (OpenAI), gemini (Google) and qwen (Alibaba). These add
# Llama, DeepSeek and Mistral.

# NVIDIA NIM - free credits, no card. Widest family variety of the free tiers:
# Llama, DeepSeek, Nemotron. https://build.nvidia.com
NVIDIA_API_KEY=

# SambaNova - free tier, no card. Llama models.
# https://cloud.sambanova.ai/apis
SAMBANOVA_API_KEY=

# Hugging Face - a read token is enough. Small free tier, huge variety.
# https://huggingface.co/settings/tokens
HF_TOKEN=

# Cloudflare Workers AI - free daily allowance. Needs BOTH values.
# https://dash.cloudflare.com -> AI -> Workers AI
CF_API_TOKEN=
CF_ACCOUNT_ID=

# Optional. Only useful with ':free' model slugs, and the daily cap is low
# unless the account has ever held credit. https://openrouter.ai/keys
OPENROUTER_API_KEY=


# ---------------------------------------------------------------------------
# Settings
# ---------------------------------------------------------------------------

# Shown on provider dashboards. Cosmetic.
APP_NAME=council

# Set this to require a password when reaching the app from your phone.
# Leave blank for no auth (fine on your own Wi-Fi, NOT fine on a public tunnel).
COUNCIL_PASSWORD=

# Per-provider concurrency override, e.g. MAX_PARALLEL=groq:2,gemini:4
# Defaults live in engine/providers.py and match each free tier's real limit
# (Groq 1, Gemini 3). You should not normally need this.
MAX_PARALLEL=
