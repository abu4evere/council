# ---------------------------------------------------------------------------
# Council - API keys
#
# Every provider below has a FREE tier that needs no payment card.
# You do NOT need all of them. Council uses whatever keys it finds and skips
# the rest. One key works. Three or four is much better, because the whole
# point of the tool is that the answers disagree with each other.
#
# Recommended order to sign up, best first:
# ---------------------------------------------------------------------------

# 1. Groq - free, no card, very fast. Start here.
#    https://console.groq.com/keys
GROQ_API_KEY=

# 2. Google AI Studio - free, no card. STRONGLY RECOMMENDED as your second key.
#    Its token ceiling is far higher than Groq's, so the seats with the biggest
#    inputs (Synthesis, Critic, Judge) live here. Without it they fall back to
#    Groq and Debate mode runs much slower.
#    https://aistudio.google.com/apikey
GEMINI_API_KEY=

# 3. Cerebras - free tier, no card, extremely fast.
#    https://cloud.cerebras.ai
CEREBRAS_API_KEY=

# 4. GitHub Models - free with any GitHub account.
#    Make a fine-grained token with NO scopes at
#    https://github.com/settings/tokens
GITHUB_TOKEN=

# 5. Mistral - free experiment tier (needs phone verification).
#    https://console.mistral.ai
MISTRAL_API_KEY=

# --- More variety. These bring model FAMILIES you do not otherwise have ---
# You have gpt-oss (OpenAI), gemini (Google) and qwen (Alibaba). These add
# Llama, DeepSeek and Mistral.

# NVIDIA NIM - free credits, no card. Widest family variety of the free tiers:
# Llama, DeepSeek, Nemotron. https://build.nvidia.com
NVIDIA_API_KEY=

# SambaNova - free tier, no card. Llama models.
# https://cloud.sambanova.ai/apis
SAMBANOVA_API_KEY=

# Hugging Face - a read token is enough. Small free tier, huge variety.
# https://huggingface.co/settings/tokens
HF_TOKEN=

# Cloudflare Workers AI - free daily allowance. Needs BOTH values.
# https://dash.cloudflare.com -> AI -> Workers AI
CF_API_TOKEN=
CF_ACCOUNT_ID=

# Optional. Only useful with ':free' model slugs, and the daily cap is low
# unless the account has ever held credit. https://openrouter.ai/keys
OPENROUTER_API_KEY=


# ---------------------------------------------------------------------------
# Settings
# ---------------------------------------------------------------------------

# Shown on provider dashboards. Cosmetic.
APP_NAME=council

# Set this to require a password when reaching the app from your phone.
# Leave blank for no auth (fine on your own Wi-Fi, NOT fine on a public tunnel).
COUNCIL_PASSWORD=

# Per-provider concurrency override, e.g. MAX_PARALLEL=groq:2,gemini:4
# Defaults live in engine/providers.py and match each free tier's real limit
# (Groq 1, Gemini 3). You should not normally need this.
MAX_PARALLEL=

# --- Long-term memory (optional) ---
# A folder of markdown notes Council searches before every run. An Obsidian
# vault is exactly this. Leave blank to disable.
VAULT_PATH=
# Extra folder names to never index, comma separated.
VAULT_EXCLUDE=

# --- Hosting Council for other people ---
# When true, runs use ONLY each user's own saved keys and never fall back to
# the keys in this file. Set this on any instance other people can reach: one
# free tier allows roughly 80 full runs a DAY across everyone, and reselling
# free-tier capacity is how vendor accounts get closed.
BYOK_ONLY=

# Encrypts users' stored API keys. Generated automatically on first run and
# written here. BACK IT UP -- losing it makes every saved key unrecoverable.
COUNCIL_SECRET=

# --- optionally paying for the two seats that need it ---
# The proposers stay free. Only Synthesis and the Judge -- the seats that read
# everything and must resolve contradictions -- are upgraded. Roughly $0.05 per
# Full run on claude-sonnet-5; claude-haiku-4.5 is about half that.
# Top up at https://openrouter.ai/credits BEFORE switching this on: with a zero
# balance every Synthesis fails with a 402.
PREMIUM_SEATS=
PREMIUM_MODEL=anthropic/claude-sonnet-5

# --- limits when other people use your instance ---
# Runs on YOUR keys are limited; runs on a visitor's own keys are not.
FREE_RUNS_PER_DAY=5
MAX_RUN_COST_CENTS=25

# --- sending verification codes -------------------------------------------
# Without these, signup codes are printed to the server console instead of
# emailed. That is fine for a private instance you run for yourself; it means
# nobody else can create an account.
#
# For Gmail: turn on 2-step verification, then create an App Password.
# SMTP_PASSWORD is full access to that mail account -- more sensitive than any
# API key here. Use a dedicated address, not your main one.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Lets the old username/password signup route work again. Leave it off unless
# you are creating the first account on an instance with no mail set up.
ALLOW_LEGACY_SIGNUP=
